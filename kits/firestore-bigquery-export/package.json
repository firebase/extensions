{
  "name": "@firebase/firestore-bigquery-export",
  "version": "0.1.0",
  "description": "Stream a Cloud Firestore collection to BigQuery as a deployable Firebase Function",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./lib": {
      "types": "./lib/lib.d.ts",
      "default": "./lib/lib.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "deploy": "pnpm build && firebase deploy --only functions",
    "serve": "firebase emulators:start --only functions"
  },
  "dependencies": {
    "@firebase/firestore-bigquery-change-tracker": "workspace:^",
    "@google-cloud/bigquery": "^7.6.0",
    "firebase-admin": "^14.1.0",
    "firebase-functions": "7.3.0-rc.0",
    "generate-schema": "^2.6.0",
    "lodash": "^4.17.14"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.0",
    "firebase-functions-test": "^3.2.0"
  }
}
