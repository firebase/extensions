{
  "name": "@firebase-function-kits/firestore-bigquery-export",
  "version": "0.0.2-rc.6",
  "repository": {
    "type": "git",
    "url": "https://github.com/firebase/extensions.git",
    "directory": "kits/firestore-bigquery-export"
  },
  "description": "Stream a Cloud Firestore collection to BigQuery as a deployable Firebase Function",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./lib": {
      "types": "./lib/lib.d.ts",
      "default": "./lib/lib.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "deploy": "pnpm build && firebase deploy --only functions",
    "serve": "firebase emulators:start --only functions"
  },
  "dependencies": {
    "@firebaseextensions/firestore-bigquery-change-tracker": "^2.1.0",
    "@google-cloud/bigquery": "^7.6.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.3.3-rc.0",
    "generate-schema": "^2.6.0",
    "lodash": "^4.17.14"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
