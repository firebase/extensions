# firestore-bigquery-export-function deploy-time params
# Copy to `.env` (all projects) or `.env.<projectId>` and fill in.
# Firebase loads these at deploy time. See:
# https://firebase.google.com/docs/functions/config-env

# --- Required ---
# Firestore collection (or collection group) to mirror. Supports wildcards,
# e.g. "users" or "regions/{regionId}/users".
COLLECTION_PATH=posts
# BigQuery dataset and table (changelog) to write into.
DATASET_ID=firestore_export
TABLE_ID=posts

# --- Common ---
# Firestore location; the functions and task queues deploy in this region.
DATABASE_REGION=us-central1
# Runtime service account email. Defaults to
# firestore-bigquery-export@<projectId>.iam.gserviceaccount.com
SERVICE_ACCOUNT=
# BigQuery dataset location (e.g. "us", "eu", "us-central1").
DATASET_LOCATION=us
# Project that owns the BigQuery dataset, if different from the Firebase project.
BIGQUERY_PROJECT_ID=
# Firestore database id. Leave as "(default)" for the default database.
DATABASE=(default)

# --- Optional behaviour ---
# Include path-param values as columns. true | false
WILDCARD_IDS=false
# Skip writing the "old" document data on updates. true | false
EXCLUDE_OLD_DATA=false
# view | materialized_incremental | materialized_non_incremental
VIEW_TYPE=view
USE_NEW_SNAPSHOT_QUERY_SYNTAX=false
# debug | info | warn | error | silent
LOG_LEVEL=info

# --- Partitioning (optional) ---
# NONE | HOUR | DAY | MONTH | YEAR
TABLE_PARTITIONING=NONE
TIME_PARTITIONING_FIELD=
# TIMESTAMP | DATE | DATETIME
TIME_PARTITIONING_FIELD_TYPE=
TIME_PARTITIONING_FIRESTORE_FIELD=

# --- Clustering (optional, comma-separated, max 4 columns) ---
CLUSTERING=

# --- Materialized view refresh (optional) ---
MAX_STALENESS=
REFRESH_INTERVAL_MINUTES=

# --- Backups (optional) ---
BACKUP_COLLECTION=

# --- Advanced (optional) ---
TRANSFORM_FUNCTION=
KMS_KEY_NAME=
