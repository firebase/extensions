{
  "name": "@firebase/firestore-counter",
  "version": "0.1.0",
  "private": false,
  "description": "Distributed, sharded counters for Firestore",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./lib": {
      "types": "./lib/lib.d.ts",
      "default": "./lib/lib.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "deploy": "pnpm build && firebase deploy --only functions",
    "serve": "firebase emulators:start --only functions"
  },
  "dependencies": {
    "deep-equal": "^1.0.1",
    "firebase-admin": "^14.1.0",
    "firebase-functions": "7.3.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/deep-equal": "^1.0.1"
  }
}
