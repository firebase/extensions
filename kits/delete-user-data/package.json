{
  "name": "@firebase-function-kits/delete-user-data",
  "version": "0.0.2-rc.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/firebase/extensions.git",
    "directory": "kits/delete-user-data"
  },
  "description": "Delete user data across Firestore, RTDB, and Storage on account deletion",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./lib": {
      "types": "./lib/lib.d.ts",
      "default": "./lib/lib.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "deploy": "pnpm build && firebase deploy --only functions",
    "serve": "firebase emulators:start --only functions"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^4.3.3",
    "firebase-admin": "^13.2.0",
    "firebase-functions": "7.3.2",
    "lodash.chunk": "^4.2.0",
    "node-fetch": "^2.6.2"
  },
  "devDependencies": {
    "@types/lodash.chunk": "^4.2.7",
    "@types/node-fetch": "^2.6.2",
    "vitest": "^4.1.10"
  }
}
