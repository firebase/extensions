{
  "name": "@firebase/firestore-genai-chatbot",
  "version": "0.1.0",
  "private": false,
  "description": "Conversational GenAI chatbot backed by Firestore",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./lib": {
      "types": "./lib/lib.d.ts",
      "default": "./lib/lib.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "deploy": "pnpm build && firebase deploy --only functions",
    "serve": "firebase emulators:start --only functions"
  },
  "dependencies": {
    "@genkit-ai/firebase": "^1.24.0",
    "@genkit-ai/google-genai": "^1.24.0",
    "@google-cloud/vertexai": "^1.1.0",
    "@google/generative-ai": "^0.1.1",
    "firebase-admin": "^14.1.0",
    "firebase-functions": "7.3.2",
    "genkit": "^1.24.0",
    "google-gax": "^4.3.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.2.0"
  }
}
